diff --git a/.github/workflows/post-merge.yml b/.github/workflows/post-merge.yml
new file mode 100644
index 00000000..195330f7
--- /dev/null
+++ b/.github/workflows/post-merge.yml
@@ -0,0 +1,50 @@
+# Post-merge settlement for the hot tier: the checks a fast-lane merge
+# deferred run here on HEAD. The shared _post-merge.yml collects the
+# checks:deferred pull requests between the `green` ref and HEAD, re-runs the
+# gate on this push event (the full tier, so `nix_build` runs the macOS build
+# on macos-latest), then fast-forwards `green` or reverts the deferred pull
+# requests.
+#
+# The profile and filters mirror ci-gate.yml's shared-gate call so the gate
+# config cannot drift; the lane path lists stay on the gate caller.
+
+name: Post-Merge
+
+on:
+  push:
+    branches: [develop]
+
+jobs:
+  post-merge:
+    permissions:
+      contents: write    # green ref moves, post-merge-red dispatches
+      pull-requests: write
+      checks: read       # AI Merge Gate verdicts on the head commits
+      actions: read      # the gate's run report reads this run's jobs
+    uses: JacobPEvans/.github/.github/workflows/_post-merge.yml@v1
+    with:
+      profile: nix       # the caller's gate stack, forwarded verbatim
+      # Same filters body as ci-gate.yml's shared-gate call.
+      filters: |
+        nix:
+          - '**.nix'
+          - 'flake.lock'
+          - 'modules/**'
+          - 'hosts/**'
+          - 'scripts/**'
+        markdown:
+          - '**.md'
+          - '.markdownlint.json'
+          - '.markdownlint.yml'
+        extra:
+          - '.claude/**'
+          # flake.lock changes the rendered settings via the nix-ai input
+          # (e.g. homelab.allowRules), so settings validation must run on a
+          # deps-only lock bump too — otherwise a stale pin ships unchecked.
+          - 'flake.lock'
+      # The one heavy tier a profile does not enable by itself: the full
+      # macOS build settles here, never on pull requests.
+      nix_build: true
+    secrets:
+      GH_APP_PRIVATE_KEY: ${{ secrets.GH_APP_PRIVATE_KEY }}
+      slack_webhook_url: ${{ secrets.SLACK_WEBHOOK_URL }}
