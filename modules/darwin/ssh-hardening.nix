# sshd hardening — declarative drop-in for macOS Remote Login.
#
# services.openssh.enable (hosts/common/default.nix) turns on launchd's
# built-in sshd with Apple's stock com.apple.ssh.sshd_config, which still
# permits password auth. This ships a drop-in under sshd_config.d/ (sshd
# reads that directory in filename order and a later file overrides an
# earlier setting for the same key — 200- sorts after Apple's own 100-
# ssh-tunnel-agent style files) so key-only auth is the enforced default
# without touching the vendor file.
{
  lib,
  config,
  ...
}:

let
  userConfig = import ../../lib/user-config.nix;
  cfg = config.security.sshCaPublicKey;
  principals = config.security.sshCaPrincipals;
  allowedUsers = lib.unique ([ userConfig.user.name ] ++ lib.attrNames principals);
  principalFiles = lib.mapAttrs' (
    loginUser: certificatePrincipals:
    lib.nameValuePair "ssh/principals/${loginUser}" {
      text = lib.concatStringsSep "\n" certificatePrincipals + "\n";
    }
  ) principals;
  sshdHardening = ''
    # Generated by nix-darwin (modules/darwin/ssh-hardening.nix) - do not edit manually
    PasswordAuthentication no
    KbdInteractiveAuthentication no
    ChallengeResponseAuthentication no
    PermitRootLogin no
    PermitEmptyPasswords no
    PubkeyAuthentication yes
    MaxAuthTries 3
    LoginGraceTime 30
    X11Forwarding no
    AllowUsers ${lib.concatStringsSep " " allowedUsers}
  ''
  + lib.optionalString (cfg != null) ''
    TrustedUserCAKeys ${cfg}
    AuthorizedPrincipalsFile /etc/ssh/principals/%u
  '';
in
{
  options.security.sshCaPublicKey = lib.mkOption {
    type = lib.types.nullOr lib.types.str;
    default = null;
    description = ''
      Path to an SSH CA public key (e.g. minted by an OpenBao SSH CA) to
      trust for certificate-based login via TrustedUserCAKeys. Leave null
      until the host has a provisioned CA public key at this path.
    '';
  };

  options.security.sshCaPrincipals = lib.mkOption {
    type = lib.types.attrsOf (lib.types.listOf lib.types.str);
    default = { };
    description = ''
      Map SSH certificate principals to the macOS login accounts that accept
      them. Each login account receives its own AuthorizedPrincipalsFile.
    '';
  };

  config.environment.etc = principalFiles // {
    "ssh/sshd_config.d/200-hardening.conf".text = sshdHardening;
  };
}
