# Minimal pf inbound baseline on top of the application firewall.
#
# The ALF (networking.applicationFirewall) is per-application and sits in
# series with this anchor: a packet this anchor passes is only delivered to a
# binary the ALF also admits (networking.applicationFirewall.allowedApps).
# Stealth mode is ON fleet-wide (hosts/common/networking.nix), so unsolicited
# probes go unanswered; allowed apps keep answering. This adds a packet-filter
# anchor loaded at boot by a launchd daemon: default-deny inbound except
# explicitly allowed TCP services, ICMP echo, SSH from an allow-listed CIDR
# set, and traffic on explicitly exempted interfaces (loopback, plus anything
# named in security.pf.exemptInterfaces). The anchor filters traffic only
# when security.pf.enforce is true.
#
# flake.nix's aarch64-darwin checks build environment.etc."pf.anchors/
# nix-hardening".text straight from the real host config and run
# `pfctl -n -f` (syntax-only parse) against it, so a bad anchor here fails
# `nix flake check` instead of shipping; pf-rule-order asserts packet
# verdicts against the rendered rules (lib/checks/pf-rule-order.nix).
{
  lib,
  config,
  pkgs,
  launchdTrampolineArgs,
  ...
}:

let
  cfg = config.security.pf;
  allowedApps = config.networking.applicationFirewall.allowedApps;
  alfAllowApps = import ./scripts/alf-allow-apps.nix { inherit pkgs; };
  anchorPath = "/etc/pf.anchors/nix-hardening";
  sshSources = "{ ${lib.concatStringsSep ", " cfg.allowedSshSources} }";

  anchorText = ''
    # Generated by nix-darwin (modules/darwin/pf-hardening.nix) - do not edit manually
    #
    # `set skip` is NOT valid inside an anchor loaded via
    # `pfctl -a <name> -f <file>` (anchors carry filter/scrub rules only,
    # not top-level pf.conf options) — exemptions are plain `pass quick`
    # rules instead, evaluated before the default-deny below. Estate rule:
    # cluster rendezvous traffic (exemptNetworks) must NEVER be touched by
    # this anchor — zero human/AI steps in cluster standup means this pf
    # anchor is not allowed to be one of them. Exemptions are stateless
    # (`no state`): a stateful pass only matches a TCP SYN, so a connection
    # opened before enforcement began would fall through to the block.
    ${lib.concatMapStrings (iface: "pass quick on ${iface} all no state\n") cfg.exemptInterfaces}
    ${lib.concatMapStrings (
      net: "pass in quick from ${net} to ${net} no state\npass out quick from ${net} to ${net} no state\n"
    ) cfg.exemptNetworks}
    # DHCP replies (a boot-time lease request is broadcast, so no state
    # matches its reply), IPv6 router and neighbor discovery, and mDNS.
    pass in quick proto udp from any port 67 to any port 68
    pass in quick inet6 proto ipv6-icmp all icmp6-type { routeradv, neighbrsol, neighbradv } no state
    pass in quick proto udp from any to { 224.0.0.251, ff02::fb } port 5353
    # Service passes are stateless (`no state`), like the exemptions above:
    # `flags S/SA keep state` matches only a TCP SYN, so every packet of a
    # flow established before enforcement began — a Prometheus keep-alive
    # scrape, a streaming LLM client — falls through to the default-deny
    # below and the flow is black-holed mid-stream. A stateless pass admits
    # each packet of the service's flows on its own merits.
    ${lib.concatMapStrings (
      service:
      let
        sources = "{ ${lib.concatStringsSep ", " service.sources} }";
        port = toString service.port;
      in
      "pass in quick proto tcp from ${sources} to any port ${port} no state\n"
      + "pass out quick proto tcp from any port ${port} to ${sources} no state\n"
    ) cfg.allowedTcpServices}
    # The same for SSH packets other than a connection-opening SYN: a session
    # from an allowed source keeps working when enforcement starts. The SYN
    # itself takes the stateful rule at the end, which keeps max-src-conn.
    pass in quick proto tcp from ${sshSources} to any port 22 flags /S no state
    pass out quick proto tcp from any port 22 to ${sshSources} no state
    block in all
    # `flags any` lets an outbound packet of a flow opened before enforcement
    # create its state, so the replies that follow pass. The quick reply
    # rules above keep service and SSH flows out of this rule: a state
    # picked up mid-flow lacks the window-scale details pf.conf(5) names.
    pass out all flags any keep state
    pass in quick proto tcp from ${sshSources} to any port 22 flags S/SA keep state (max-src-conn 10)
    pass in quick inet proto icmp icmp-type echoreq keep state
  '';

  # The stock /etc/pf.conf evaluates every com.apple/* anchor, so only the
  # enforced name filters traffic; the other name is flushed on each load.
  enforcedAnchor = "com.apple/nix-hardening";
  inertAnchor = "nix-hardening";

  # writeShellApplication sets -euo pipefail: a failed load aborts and launchd
  # records a non-zero exit instead of silently leaving pf unloaded.
  loadAnchor = pkgs.writeShellApplication {
    name = "pf-hardening-load";
    # tee comes from coreutils whatever PATH launchd or activation provides.
    runtimeInputs = [ pkgs.coreutils ];
    text = ''
      export PF_ANCHOR=${if cfg.enforce then enforcedAnchor else inertAnchor}
      export PF_OTHER_ANCHOR=${if cfg.enforce then inertAnchor else enforcedAnchor}
      export PF_ANCHOR_FILE=${anchorPath}
    ''
    + builtins.readFile ./scripts/pf-hardening-load.sh;
  };
in
{
  options.security.pf = {
    enforce = lib.mkOption {
      type = lib.types.bool;
      default = false;
      description = ''
        Make the anchor filter inbound traffic. When true, activation loads it
        as `com.apple/nix-hardening`, which the stock `/etc/pf.conf` evaluates
        through `anchor "com.apple/*"`, so its default-deny drops every
        inbound connection that no rule here allows. When false (the
        default), it loads as `nix-hardening`, which nothing evaluates.
        Activation flushes the other name, so turning this off and
        re-activating removes enforcement.
      '';
    };

    allowedTcpServices = lib.mkOption {
      type = lib.types.listOf (
        lib.types.submodule {
          options = {
            sources = lib.mkOption {
              type = lib.types.addCheck (lib.types.listOf (lib.types.strMatching ".+")) (sources: sources != [ ]);
              description = "Non-empty list of PF source tokens permitted to reach this TCP port.";
            };

            port = lib.mkOption {
              type = lib.types.ints.between 1 65535;
              description = "TCP destination port permitted from the listed sources.";
            };
          };
        }
      );
      default = [ ];
      description = ''
        Additional inbound TCP services allowed by the pf anchor. Each entry
        must provide one or more source tokens and a destination port. Rules
        are emitted before the default inbound block; no services are allowed
        by default.
      '';
    };

    allowedSshSources = lib.mkOption {
      type = lib.types.listOf lib.types.str;
      # ponytail: single broad RFC1918 default, narrow per-fleet CIDR if a
      # tighter allow-list is ever needed.
      default = [ "10.0.0.0/8" ];
      description = "CIDRs permitted to reach TCP/22 through the pf anchor.";
    };

    exemptInterfaces = lib.mkOption {
      type = lib.types.listOf lib.types.str;
      default = [
        "lo0"
        "bridge0"
      ];
      description = ''
        Interfaces fully exempt from the pf anchor's default-deny (`pass
        quick on <iface> all no state`, evaluated first). Loopback plus bridge0 —
        the Thunderbolt Bridge network-service device cluster-link-prep.nix
        keeps disabled/unenslaved for RDMA exclusivity, so this entry
        currently matches no live traffic, but stays declared for the
        window cluster-link-prep briefly touches bridge0 during its sweep.
        Deliberately NOT a wildcard en* glob: that would exempt the primary
        LAN NIC (en0) from the entire ruleset, defeating the default-deny.
        The actual Thunderbolt RDMA link is covered by exemptNetworks
        below instead, since it rides whichever physical enN port is
        cabled (no fixed name — see cluster-link-prep.nix).
      '';
    };

    exemptNetworks = lib.mkOption {
      type = lib.types.listOf lib.types.str;
      # Reuses cluster-link-prep.nix's own network option (one shared
      # source, never a second literal copy of the /24 that could drift).
      default = [ config.system.clusterLinkPrep.network ];
      description = ''
        CIDRs fully exempt from the pf anchor's default-deny, matched by
        address rather than interface (`pass in/out quick from <cidr> to
        <cidr> no state`, evaluated before the default-deny). Exists so
        Thunderbolt RDMA cluster rendezvous traffic — which rides whichever
        physical enN port is cabled, never a fixed interface name — is
        never blocked: the estate rule forbids any human/AI step in
        cluster standup, and this anchor must not become one.
      '';
    };
  };

  options.networking.applicationFirewall.allowedApps = lib.mkOption {
    type = lib.types.listOf (lib.types.strMatching "${builtins.storeDir}/.+");
    default = [ ];
    description = ''
      Nix store executable paths to add to the application firewall and
      unblock during activation. Activation first removes other Nix store
      entries with the same executable name (scripts/alf-allow-apps.sh).
      Consumers must supply stable executable paths; the list is empty by
      default.
    '';
  };

  config = {
    environment.etc."pf.anchors/nix-hardening".text = anchorText;

    launchd.daemons.pf-hardening = {
      serviceConfig = {
        Label = "com.nix-darwin.pf-hardening";
        ProgramArguments = launchdTrampolineArgs "pf-hardening" [ (lib.getExe loadAnchor) ];
        RunAtLoad = true;
        # A boot-time load can fail before DNS answers (sources may be host
        # names); launchd reruns a failed load every 30 s until one succeeds.
        KeepAlive.SuccessfulExit = false;
        ThrottleInterval = 30;
        StandardOutPath = "/var/log/pf-hardening.log";
        StandardErrorPath = "/var/log/pf-hardening.log";
      };
    };

    system.activationScripts.postActivation.text = lib.mkAfter (
      ''
        ${lib.getExe loadAnchor} || echo "pf-hardening-load: non-fatal failure (see log above)"
      ''
      + lib.optionalString (allowedApps != [ ]) ''
        ${lib.getExe alfAllowApps} ${lib.escapeShellArgs allowedApps} || echo "alf-allow-apps: non-fatal failure (see log above)"
      ''
    );
  };
}
