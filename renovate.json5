// Renovate configuration for nix-darwin.
//
// Inherits organization Renovate policy from the shared Nix preset. Only
// repository-specific custom managers and supervised-file holds live here.
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>dryvist/.github:renovate-nix"
  ],

  "customManagers": [
    {
      // Bumps only the version in the release URL. The accompanying fetchzip
      // `hash` is content-addressed and cannot be derived from a regex match
      // — the Renovate PR's Nix build fails with the correct hash in its
      // error, same as any Nix fixed-output-hash bump; land it by copying
      // that hash in.
      "customType": "regex",
      "managerFilePatterns": ["/hosts/common/cribl\\.nix$/"],
      "matchStrings": [
        "/releases/download/v(?<currentValue>[^/]+)/cc-edge-the-mac-pack-io-v[^\"]+\\.crbl\"; # renovate: cc-edge-the-mac-pack-io"
      ],
      "depNameTemplate": "dryvist/cc-edge-the-mac-pack-io",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "loose"
    },
    {
      // Digest-pins the macOS base VM. The -base image publishes only the
      // `latest` tag, so the sha256 digest is the immutable reference.
      "customType": "regex",
      "managerFilePatterns": ["/modules/darwin/apps/macos-vm-runner\\.nix$/"],
      "matchStrings": [
        "ghcr\\.io/cirruslabs/macos-tahoe-base@(?<currentDigest>sha256:[a-f0-9]{64})\"; # renovate: macos-tahoe-base"
      ],
      "depNameTemplate": "ghcr.io/cirruslabs/macos-tahoe-base",
      "currentValueTemplate": "latest",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],

  // Repo-specific guard: these cluster-critical files need supervised changes.
  "packageRules": [
    {
      "matchFileNames": [
        "hosts/common/cluster-wired-limit.nix",
        "hosts/common/cluster-quiesce.nix",
        "modules/darwin/cluster-link-prep.nix"
      ],
      "enabled": false
    }
  ]
}
