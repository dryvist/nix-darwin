{
  pkgs,
  macbook,
  studio,
}:
let
  macbookPrimaryUser = macbook.config.system.primaryUser;
  studioPrimaryUser = studio.config.system.primaryUser;
  macbookSshdConfig = macbook.config.environment.etc."ssh/sshd_config.d/200-hardening.conf".text;
  studioSshdConfig = studio.config.environment.etc."ssh/sshd_config.d/200-hardening.conf".text;
  studioWithoutPrincipals = studio.extendModules {
    modules = [ { security.sshCaPrincipals = pkgs.lib.mkForce { }; } ];
  };
  studioWithoutPrincipalsSshdConfig =
    studioWithoutPrincipals.config.environment.etc."ssh/sshd_config.d/200-hardening.conf".text;
  expectedMacbookSshdConfig = ''
    # Generated by nix-darwin (modules/darwin/ssh-hardening.nix) - do not edit manually
    PasswordAuthentication no
    KbdInteractiveAuthentication no
    ChallengeResponseAuthentication no
    PermitRootLogin no
    PermitEmptyPasswords no
    PubkeyAuthentication yes
    MaxAuthTries 3
    LoginGraceTime 30
    X11Forwarding no
    AllowUsers ${macbookPrimaryUser}
  '';
in
assert macbookSshdConfig == expectedMacbookSshdConfig;
assert
  studio.config.environment.etc."ssh/principals/${studioPrimaryUser}".text
  == "${studioPrimaryUser}\n";
assert studio.config.environment.etc."ssh/principals/host-admin".text == "ai-agent\n";
assert pkgs.lib.hasInfix "AuthorizedPrincipalsFile /etc/ssh/principals/%u" studioSshdConfig;
assert pkgs.lib.hasInfix "TrustedUserCAKeys /etc/ssh/trusted-user-ca-keys.pem"
  studioWithoutPrincipalsSshdConfig;
assert !pkgs.lib.hasInfix "AuthorizedPrincipalsFile" studioWithoutPrincipalsSshdConfig;
pkgs.runCommand "check-ssh-principals" { } "touch $out"
