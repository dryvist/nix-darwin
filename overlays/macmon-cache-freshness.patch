+pub struct Sample {
+  pub metrics: Metrics,
+  pub timestamp: chrono::DateTime<chrono::Utc>,
+  pub completed: Instant,
+}

+impl Sample {
+  pub fn new(metrics: Metrics) -> Self {
+    Self { metrics, timestamp: chrono::Utc::now(), completed: Instant::now() }
+  }
+
+  fn is_fresh(
+    &self,
+    now: Instant,
+    wall_now: chrono::DateTime<chrono::Utc>,
+    max_age: Duration,
+  ) -> bool {
+    now.saturating_duration_since(self.completed) <= max_age
+      && wall_now.signed_duration_since(self.timestamp).to_std().is_ok_and(|age| age <= max_age)
+  }
+}
+
+pub type SharedMetrics = Arc<RwLock<Option<Sample>>>;
